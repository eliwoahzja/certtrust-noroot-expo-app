{
  "expo": {
    "name": "CertTrust No-Root",
    "slug": "certtrust-noroot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.certmanager.noroot",
      "permissions": [
        "android.permission.INTERNET",
        "rikka.shizuku.permission.API_V23"
      ]
    },
    "plugins": [
      "./plugins/withNativeModules"
    ],
    "extra": {
      "eas": {
        "projectId": "certtrust-noroot-project"
      }
    }
  }
}